# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://tsg-ecru.vercel.app,https://tsg-qlb1.onrender.com
JSON_BODY_LIMIT=5mb

# Database (PostgreSQL / Neon DB connection string)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/lms_db?sslmode=require

# Authentication (Secure 64-char random string in production)
JWT_SECRET=your_production_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret_key

# Cloudinary Storage for Videos & PDFs
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# OpenAI API Key (Optional AI Doubt Mentor)
OPENAI_API_KEY=your_openai_api_key
